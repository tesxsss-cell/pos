APP_NAME="POS Toko Koperasi Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# DB_DATABASE boleh dikosongkan untuk database/database.sqlite.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
